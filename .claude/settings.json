{
  "permissions": {
    "allow": [
      "Bash(vendor/bin/phpunit)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(php -l:*)",
      "Bash(composer install:*)",
      "Bash(composer validate:*)",
      "Bash(bash bin/build-zip.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
